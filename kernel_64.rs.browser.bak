// Виртуальная файловая система (VFS) в памяти
#[derive(Copy, Clone, PartialEq)]
pub enum VfsKind {
    Empty,
    Folder,
    Txt,
    Bmp,
    Mrt,
    Asm,
    Cpp,
    Cs,
    Sys,
}

#[derive(Copy, Clone)]
pub struct VfsNode {
    pub kind: VfsKind,
    pub parent: usize,
    pub name: [u8; 32],
    pub name_len: usize,
    pub content: [u8; 256],
    pub content_len: usize,
}

impl VfsNode {
    const fn empty() -> Self {
        Self {
            kind: VfsKind::Empty,
            parent: 0,
            name: [0; 32],
            name_len: 0,
            content: [0; 256],
            content_len: 0,
        }
    }
    fn name_str(&self) -> &str {
        core::str::from_utf8(&self.name[..self.name_len]).unwrap_or("unnamed")
    }
}

